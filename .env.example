# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens for authentication.
JWT_SECRET="credittrack_super_secure_jwt_secret_change_in_production"

# DATABASE_URL: Optional PostgreSQL connection string (Neon, Supabase, Cloud SQL, Vercel Postgres).
# When omitted, CreditTrack operates seamlessly using its internal persistent store.
DATABASE_URL="postgresql://user:password@host:5432/credittrack?sslmode=require"

# PORT: Server port (defaults to 3000)
PORT="3000"

# GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Client ID for Google Identity Services / Sign in with Google
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# NODE_ENV: 'development' or 'production'
NODE_ENV="development"
